# Vendra repository ignores.
#
# Secrets are never committed. .env.example IS committed so the project can be
# set up from a clean clone.

# ---------------------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Any stray key material, regardless of extension.
*.pem
*.key
*.p12
*.keystore

# Credentials must never be committed. These match the *content* of a file, so
# they catch a key pasted into an unexpected place, while still allowing a
# legitimately named source file such as
# supabase/migrations/*_service_role_grants.sql to be tracked.
service_role_key=
service_role=
SUPABASE_SERVICE_ROLE_KEY=[A-Za-z0-9._-]+
suiprivkey1
GOOGLE_GENERATIVE_AI_API_KEY=[A-Za-z0-9._-]{20,}
WALRUS_DELEGATE_PRIVATE_KEY=[A-Za-z0-9._-]{8,}

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
web/.next/
web/out/
web/build/
web/.vercel/
dist/
build/

# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Logs and editor noise
# ---------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
next-env.d.ts

# ---------------------------------------------------------------------------
# Supabase CLI local state
# ---------------------------------------------------------------------------
# supabase/.temp holds the local stack's API keys.
supabase/.temp/
.branches/
supabase/.branches/

# ---------------------------------------------------------------------------
# Design source assets
# ---------------------------------------------------------------------------
# The approved video source and generation stills are retained locally. They
# are large binaries and the optimised web copy is what ships.
video/*.mp4
video/*.mov
video/*.webm

# ---------------------------------------------------------------------------
# Evidence and pilot material
# ---------------------------------------------------------------------------
# Real retailer evidence and consented screenshots must never enter version
# control. Public evidence is redacted and placed in docs/ deliberately.
docs/evidence-local/
*.heic

# ---------------------------------------------------------------------------
# Demo film
# ---------------------------------------------------------------------------
# The rendered mp4 is a deliverable and is large. It belongs in a release or a
# submission rather than in version control.
demo/out/
demo/.remotion/
demo/music/*.wav
demo/public/mix.wav
demo/analysis/voiceover/audio/*.pcm
demo/analysis/voiceover/audio/*.wav
demo/public/screens/*.png
demo/music/sourced/*.mp3
demo/music/sourced/*.wav
