# Vendra environment variables.
# Copy to web/.env.local for local development, and configure the same names in
# your hosting provider's environment settings. NEVER commit a real .env file.

# ---------------------------------------------------------------------------
# Public browser-safe values
# ---------------------------------------------------------------------------
# From your Supabase project: Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployment, used for auth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only Supabase credentials
# ---------------------------------------------------------------------------
# Server-only. Bypasses Row Level Security, so it must never reach a browser
# bundle, a log line or source control.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI model provider (server only)
# ---------------------------------------------------------------------------
# Server-only. Without it, Ask Vendra falls back to a deterministic summary of
# your saved records and labelled as not a model answer.
GOOGLE_GENERATIVE_AI_API_KEY=
# Pinned after verifying the current Gemini catalogue. Default: gemini-2.5-flash
GOOGLE_MODEL_ID=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Walrus Memory (server only)
# ---------------------------------------------------------------------------
# CUSTODY MODEL: service_managed. Vendra's server controls the Walrus owner
# account. Each shop still gets its own account reference and its own unique
# namespace, assigned server-side and never accepted from the browser.
# The retailer does NOT hold the owner key, and the UI says so.
#
# Leave these empty to run without deal memory: deal records still save, and
# Ask Vendra reports that memory is unavailable rather than faking recall.
#
# @mysten-incubation/memwal 0.1.8
WALRUS_MEMORY_API_URL=https://relayer.memory.walrus.xyz
WALRUS_NETWORK=testnet
# Walrus Memory account object ID on Sui.
WALRUS_MEMORY_ACCOUNT_ID=
# Read credential for the relayer.
WALRUS_READER_CREDENTIAL=
# Ed25519 delegate private key (hex or suiprivkey1...). Server-only. Never stored
# in the database, browser storage, logs or source control.
WALRUS_DELEGATE_PRIVATE_KEY=
# Reference recorded on shops.walrus_delegate_key_ref. Points at the key in the
# server-side key store; it is not the key itself.
WALRUS_DELEGATE_KEY_REF=walrus-delegate/default
# service_custodian = the server signs as custodian.
# external_owner   = owner wallet signs; server-side writes are refused.
WALRUS_OWNER_SIGNING_MODE=service_custodian
# Testnet gas top-up for the delegate, in SUI.
WALRUS_FAUCET_SUI=0.5

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Paystack is not enabled in the challenge MVP. Billing is deliberately absent
# from the settings UI until paid billing is approved and tested.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Error monitoring. Content must be redacted: never send deal text, file
# contents, chat prompts or memory statements to an error tracker.
SENTRY_DSN=