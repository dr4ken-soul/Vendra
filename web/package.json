    "test:erasure": "vitest run --config vitest.config.ts ../tests/privacy-erasure",
    "verify:clean": "node scripts/verify-clean.mjs",
    "clean:test": "node scripts/clean-test-data.mjs",
    "auth:list": "node scripts/list-auth-users.mjs",
    "user:create": "node scripts/create-confirmed-user.mjs",
    "deploy": "vercel --prod",
